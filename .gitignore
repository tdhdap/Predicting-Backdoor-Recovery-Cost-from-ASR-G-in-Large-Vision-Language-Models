# ---- model weights & checkpoints: never commit ----
# large, regenerable, and (for the backdoored ones) must not be distributed per the
# paper's responsible-disclosure statement.
*.pt
*.pth
*.ckpt
*.safetensors

# ---- data & archives ----
data/
*.zip
*.tar
*.tar.gz

# ---- heavy run outputs, but KEEP the lightweight analysis (csv/png/summary) ----
runs/**/backdoors/
runs/**/base.pt
runs/**/*.pt
# (runs/<name>/analysis/ with CSVs + figures is small and IS tracked)

# ---- python junk ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# ---- os / editor ----
.DS_Store
.idea/
.vscode/
